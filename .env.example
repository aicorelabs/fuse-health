# Database — local Postgres in docker compose
DATABASE_URL="postgresql://fuse:fuse@localhost:5432/fuse?schema=public"
DIRECT_URL="postgresql://fuse:fuse@localhost:5432/fuse?schema=public"

# Admin auth (single user, env-based)
# Generate the hash with: pnpm --filter @fuse/web exec tsx scripts/hash-password.ts <password>
ADMIN_EMAIL="admin@fuse.local"
ADMIN_PASSWORD_HASH=""

# Session — sign JWT cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Anthropic — only required external dependency
ANTHROPIC_API_KEY=""
