# Database — local Postgres in docker compose
DATABASE_URL="postgresql://fuse:fuse@localhost:5432/fuse?schema=public"
DIRECT_URL="postgresql://fuse:fuse@localhost:5432/fuse?schema=public"

# Admin auth (single user, env-based)
# Generate the line with: pnpm hash-password <password>
# (Each `$` in the hash is escaped as `\$` because Next.js expands $VAR refs in .env.)
ADMIN_EMAIL="admin@fuse.local"
ADMIN_PASSWORD_HASH=""

# Session — sign JWT cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Groq — LLM provider used by the `llm` node
GROQ_API_KEY=""

# Master key for encrypting per-integration variables (the {{ vars.X }} you
# reference from custom integration headers/paths/bodies). Any string;
# SHA-256 derives the AES-256 key. Generate with: openssl rand -hex 32
# Rotate by re-saving each integration's vars after changing it.
FUSE_SECRET_KEY=""
