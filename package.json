{
  "name": "fuse-home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @fuse/db generate",
    "db:migrate": "pnpm --filter @fuse/db migrate",
    "db:studio": "pnpm --filter @fuse/db studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
