// Fuse-home Prisma schema — v1
// No User table (env-based admin auth). No Patient table (parameters supplied at trigger).
// No McpServer table (Fuse-as-MCP-server is v2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workflow {
  id            String   @id @default(cuid())
  name          String
  description   String?
  graph         Json
  maxConcurrent Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs WorkflowRun[]
}

model WorkflowRun {
  id            String    @id @default(cuid())
  workflowId    String
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status        RunStatus @default(PENDING)
  input         Json
  output        Json?
  error         String?
  graphSnapshot Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  steps WorkflowStepRun[]

  @@index([workflowId, createdAt])
}

model WorkflowStepRun {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  status     RunStatus   @default(PENDING)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([runId])
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}
